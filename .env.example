# Copy to .env locally. Never commit .env or the Google client JSON.
INBOXOPS_MODE=live
PORT=4317
OLLAMA_MODEL=qwen3:4b
OLLAMA_EMBED_MODEL=embeddinggemma
# Keep the OAuth client JSON OUTSIDE this repository.
# GOOGLE_OAUTH_CLIENT_FILE=C:/Users/YOUR_NAME/.inboxops/google-client.json
# TEST_ACCOUNT=your-dedicated-test-account@gmail.com
# TEST_RECIPIENTS=another-test-address-you-control@gmail.com
TEST_LABEL_NAME=InboxOps-Test
# Optional explicit ID overrides the exact name lookup:
# TEST_LABEL_ID=Label_123456789
# TEST_CALENDAR_ID=your-owned-test-calendar-id@group.calendar.google.com
