{
  "name": "inboxops-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "model:check": "node --env-file-if-exists=.env --import tsx scripts/model-check.ts",
    "model:integration": "node --env-file-if-exists=.env --import tsx scripts/model-integration.ts",
    "setup:google": "tsx scripts/setup-google.ts",
    "mcp:inspect": "tsx scripts/mcp-inspect.ts",
    "mcp:server": "tsx server/stdio.ts",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "format:check": "prettier --check server src tests scripts *.ts *.json index.html",
    "evidence:fixture": "tsx scripts/fixture-evidence.ts",
    "evidence:export": "node --env-file-if-exists=.env --import tsx scripts/export-evidence.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "express": "^5.1.0",
    "google-auth-library": "^10.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.52.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "prettier": "^3.9.9",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
